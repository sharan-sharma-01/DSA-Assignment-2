#include <iostream>
using namespace std;

int main() {
    int arr[] = {1, 3, 4, 2, 6};
    int n = 5;
    int k = 2; 

    for (int i = 0; i <= n - 1; i++) {
        for (int j = i + 1; j <= n - 1; j++) {
            if (abs(arr[j] - arr[i]) == k) {
                cout << "The pairs are " << arr[j] << "," << arr[i] << endl;
            }
        }
    }
}
